# ===================================================================
# Local Development PostgreSQL Configuration
# ===================================================================
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/krishna_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=krishna_db

# ===================================================================
# Production (Render / Cloud Hosting) Configuration
# ===================================================================
# In Render Dashboard -> Web Service -> Environment:
# Add DATABASE_URL with your Render PostgreSQL Internal or External Connection URL:
# DATABASE_URL=postgresql://user:password@dpg-xxxx.render.com/krishna_db
# AUTH_SECRET=your-production-jwt-secret-key
