# Krishna Accessories - Backend Environment Configuration
# ==========================================================
# GMAIL SMTP SETUP INSTRUCTIONS (ગૂગલ જીમેલ સેટઅપ માટે સૂચનાઓ):
# 1. Open your Google Account: https://myaccount.google.com/security
# 2. Enable "2-Step Verification" (જો ચાલુ ન હોય તો ચાલુ કરો).
# 3. Go to "App Passwords" (https://myaccount.google.com/apppasswords).
# 4. App Name માં "Krishna Accessories" લખો અને "Create" બટન દબાવો.
# 5. તમને 16 અક્ષરનો પાસવર્ડ મળશે (જેમ કે: abcd efgh ijkl mnop).
# 6. નીચે SMTP_USER માં તમારું Gmail અને SMTP_PASS માં 16-અક્ષરનો પાસવર્ડ લખો.
# ==========================================================

# SMTP Configuration (Gmail / Brevo / Outlook / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Krishna Accessories Mumbai"
SMTP_SECURE=tls

# Server Configuration
PORT=8000
HOST=127.0.0.1
